{
  "name": "dolphin_web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cd web && node ../tools/serve.mjs",
    "play": "cd web && node ../tools/serve.mjs --open",
    "smoke": "node tests/artifacts.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run smoke && npm test",
    "test:e2e": "node tests/browser.mjs && node tests/core-browser.mjs",
    "test:regression": "npm test",
    "test:core": "node tests/core-browser.mjs",
    "test:live": "node tests/live-archive.mjs",
    "build": "node tools/build.mjs",
    "prestart": "node tools/build.mjs",
    "preplay": "node tools/build.mjs",
    "watch": "node tools/watch-ui.mjs",
    "import:runtime": "node tools/import-runtime.mjs",
    "test:ios": "node tests/ios-webkit.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "puppeteer-core": "^25.13.0"
  }
}
