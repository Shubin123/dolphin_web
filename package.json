{
  "name": "dolphin_web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cd web && node tools/serve.mjs",
    "play": "cd web && node tools/serve.mjs --open",
    "smoke": "node tests/artifacts.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run smoke && npm test",
    "test:e2e": "node tests/browser.mjs && node tests/core-browser.mjs",
    "test:regression": "npm test",
    "test:core": "node tests/core-browser.mjs",
    "test:live": "node tests/live-archive.mjs",
    "build": "node tools/build.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.13.0"
  }
}
